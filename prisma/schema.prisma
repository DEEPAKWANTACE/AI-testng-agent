// AI QA Testing Agent — data model.
//
// Workflow:
//   Project → Application → Feature / DiscoveryRun
//   TestSuite (editable working copy of test cases + steps)
//     → PlanVersion (immutable snapshot, submitted for review) → Approval
//     → TestRun (executes one approved PlanVersion) → TestResult → StepResult
//   Defects and Artifacts attach to the evidence they came from.
//
// Actor columns (createdBy, reviewer, …) are nullable with ON DELETE SET NULL so that
// removing a user never deletes history. Some invariants the Prisma schema language
// can't express (partial unique indexes, check constraints) live in the migration SQL.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  QA_LEAD
  QA_ENGINEER
  VIEWER
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

/// Per-project access. Global `UserRole.ADMIN` users can access every project.
enum ProjectRole {
  OWNER
  EDITOR
  VIEWER
}

/// Where a secret reference points. Secret values are never stored in this database.
enum SecretProvider {
  ENV
  VAULT
  AWS_SECRETS_MANAGER
  GCP_SECRET_MANAGER
  AZURE_KEY_VAULT
  /// Entered in the dashboard; stored AES-256-GCM encrypted (see modules/secrets/vault.ts).
  LOCAL
}

enum AppEnvironment {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

enum AppType {
  WEB
  API
  MOBILE
}

enum FeatureStatus {
  ACTIVE
  DEPRECATED
}

/// Where a record came from: written by a person, generated by AI, or found by discovery.
enum ContentSource {
  MANUAL
  AI_GENERATED
  DISCOVERED
}

enum DiscoveryAuthMode {
  NONE
  FORM_LOGIN
}

enum DiscoveryRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum TestSuiteStatus {
  ACTIVE
  ARCHIVED
}

enum TestCaseStatus {
  ACTIVE
  ARCHIVED
}

enum TestCaseType {
  FUNCTIONAL
  SMOKE
  REGRESSION
  ACCESSIBILITY
  VISUAL
  API
  END_TO_END
  POSITIVE
  NEGATIVE
  BOUNDARY
  PERMISSION
}

/// Review state of a case in a draft suite. Only ACCEPTED cases go into a plan version.
enum CaseReviewState {
  PROPOSED
  ACCEPTED
  REJECTED
}

/// Executable step actions. Anything else is not executable.
enum StepKind {
  NAVIGATE
  CLICK
  FILL
  SELECT
  WAIT
  ASSERT
  RELOAD
  EXTRACT
  ASSERT_CALC
  API_GET
  ASSERT_RESPONSE
  ASSERT_VISUAL
}

/// Lifecycle of a visual baseline image. Only APPROVED baselines are compared against.
enum BaselineStatus {
  /// Captured by a run; waiting for a reviewer.
  PENDING
  APPROVED
  REJECTED
  /// Replaced by a newer approved baseline (or a newer candidate).
  SUPERSEDED
}

enum SuiteKind {
  STANDARD
  REGRESSION
}

enum GenerationStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

/// How a case's result compares with the same case (by caseKey) in the previous run.
enum ResultComparison {
  NEW
  UNCHANGED
  REGRESSED
  FIXED
  STILL_FAILING
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PlanVersionStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  /// A newer version of the same suite was approved.
  SUPERSEDED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TestRunStatus {
  QUEUED
  RUNNING
  PASSED
  FAILED
  /// Refused before execution: approval, hash, target or environment checks failed.
  BLOCKED
  /// Executed, nothing failed, but at least one case couldn't produce a trustworthy verdict.
  INCONCLUSIVE
  /// Infrastructure failure (worker, browser, time limit) after the retry budget.
  ERROR
  CANCELLED
}

enum TestRunTrigger {
  MANUAL
  SCHEDULED
  CI
  /// Baseline run of a mutation analysis.
  MUTATION
}

/// Outcome of a test case or an individual step within a run.
/// PASSED/FAILED are verdicts; BLOCKED = couldn't start (precondition, scope, secret);
/// INCONCLUSIVE = ran but the evidence doesn't support a verdict either way.
enum ResultStatus {
  PASSED
  FAILED
  SKIPPED
  BLOCKED
  INCONCLUSIVE
  /// Legacy: older runs recorded infrastructure problems per case as ERROR.
  ERROR
}

/// Why a step didn't pass. Only APPLICATION failures can become defects.
enum FailureClass {
  /// The application's observable behaviour contradicts a deterministic assertion.
  APPLICATION
  /// The test itself is suspect (locator not found or ambiguous, invalid scope).
  TEST_DEFINITION
  /// Browser, network, proxy or worker problems.
  INFRASTRUCTURE
  /// Target unreachable, redirected out of scope, missing secret or precondition.
  ENVIRONMENT
  UNKNOWN
}

enum DefectSeverity {
  CRITICAL
  MAJOR
  MINOR
  TRIVIAL
}

/// How far a defect's existence has been verified. Automated runs can only reach REPRODUCED
/// (the same failure on every attempt); CONFIRMED requires a person who reviewed the evidence.
/// This is about whether the defect exists, never about its root cause.
enum DefectVerification {
  REPRODUCED
  CONFIRMED
  /// A person reviewed the evidence and could not confirm it (or it no longer reproduces).
  NOT_CONFIRMED
}

enum DefectStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  WONT_FIX
}

enum ArtifactKind {
  SCREENSHOT
  VIDEO
  TRACE
  LOG
  HAR
  DOM_SNAPSHOT
  REPORT
  OTHER
}

// ─── Identity ───────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(cuid())
  /// Stored lower-cased; normalised by the application layer.
  email        String     @unique
  name         String
  role         UserRole   @default(QA_ENGINEER)
  status       UserStatus @default(ACTIVE)
  /// scrypt hash (`scrypt$N$r$p$salt$hash`); a CHECK constraint rejects any other format.
  /// Null for users who can't sign in yet (e.g. invited).
  passwordHash String?
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  sessions            Session[]
  memberships         ProjectMember[]
  createdSecrets      ApplicationSecret[] @relation("ApplicationSecretCreatedBy")
  generationJobs      GenerationJob[]     @relation("GenerationJobRequestedBy")
  triggeredDiscovery  DiscoveryRun[]      @relation("DiscoveryRunTriggeredBy")
  createdSuites       TestSuite[]         @relation("TestSuiteCreatedBy")
  createdCases        TestCase[]          @relation("TestCaseCreatedBy")
  createdPlanVersions PlanVersion[]       @relation("PlanVersionCreatedBy")
  requestedApprovals  Approval[]          @relation("ApprovalRequestedBy")
  reviewedApprovals   Approval[]          @relation("ApprovalReviewer")
  triggeredRuns       TestRun[]           @relation("TestRunTriggeredBy")
  reportedDefects     Defect[]            @relation("DefectReporter")
  assignedDefects     Defect[]            @relation("DefectAssignee")
  verifiedDefects     Defect[]            @relation("DefectVerifiedBy")
  reviewedBaselines   VisualBaseline[]    @relation("BaselineReviewer")
  inventoryDocs       InventoryDocument[] @relation("InventoryDocumentCreatedBy")
  sourceAnalyses      SourceAnalysis[]    @relation("SourceAnalysisTriggeredBy")
  mutationRuns        MutationRun[]       @relation("MutationRunTriggeredBy")

  @@index([status, role])
}

/// Server-side session. Only a SHA-256 hash of the cookie token is stored, so a database
/// leak doesn't expose usable session tokens.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ─── Inventory ──────────────────────────────────────────────────────────────

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  members      ProjectMember[]
  applications Application[]

  @@index([status, createdAt])
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ProjectRole @default(VIEWER)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([projectId, userId])
  @@index([userId])
}

model Application {
  id            String         @id @default(cuid())
  projectId     String
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String
  /// The only origin the agent may test. Runs and discovery are confined to it.
  authorizedUrl String
  type          AppType        @default(WEB)
  environment   AppEnvironment @default(STAGING)
  description   String?
  /// Optional source repository (https or ssh). Credentials in the URL are rejected.
  repoUrl       String?
  /// Branch to test; requires `repoUrl`. Null means the repository's default branch.
  repoBranch    String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  secrets         ApplicationSecret[]
  discoveryAuth   DiscoveryAuthConfig?
  generationJobs  GenerationJob[]
  features        Feature[]
  discoveryRuns   DiscoveryRun[]
  testSuites      TestSuite[]
  defects         Defect[]
  visualBaselines VisualBaseline[]
  inventoryItems  InventoryItem[]
  inventoryDocs   InventoryDocument[]
  sourceAnalyses  SourceAnalysis[]

  @@unique([projectId, name])
  @@index([createdAt])
}

/// A named pointer to a secret held in an external secret manager (e.g. test-account
/// credentials). Only the reference is stored; values are resolved at use time.
model ApplicationSecret {
  id             String         @id @default(cuid())
  applicationId  String
  application    Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  /// Identifier used by tests, e.g. TEST_USER_PASSWORD.
  name           String
  provider       SecretProvider
  /// e.g. env://QA_STOREFRONT_PASSWORD or vault://kv/qa/storefront#password
  reference      String
  /// AES-256-GCM ciphertext (iv.tag.data, base64url) for LOCAL secrets; null for external references.
  encryptedValue String?
  description    String?
  createdById    String?
  createdBy      User?          @relation("ApplicationSecretCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  usedAsDiscoveryUsername DiscoveryAuthConfig[] @relation("DiscoveryAuthUsername")
  usedAsDiscoveryPassword DiscoveryAuthConfig[] @relation("DiscoveryAuthPassword")

  @@unique([applicationId, name])
  @@index([createdById])
}

/// How the discovery worker signs in to an application before crawling. Credentials are
/// secret *references*, resolved by the worker at run time and never stored or logged.
model DiscoveryAuthConfig {
  id               String             @id @default(cuid())
  applicationId    String             @unique
  application      Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  mode             DiscoveryAuthMode  @default(NONE)
  /// Must be within the application's authorized URL.
  loginUrl         String?
  usernameSecretId String?
  usernameSecret   ApplicationSecret? @relation("DiscoveryAuthUsername", fields: [usernameSecretId], references: [id], onDelete: NoAction)
  passwordSecretId String?
  passwordSecret   ApplicationSecret? @relation("DiscoveryAuthPassword", fields: [passwordSecretId], references: [id], onDelete: NoAction)
  /// Optional CSS selectors; sensible defaults are detected when omitted.
  usernameSelector String?
  passwordSelector String?
  submitSelector   String?
  /// CSS selector present only when signed in, used to confirm the login worked.
  successSelector  String?
  updatedAt        DateTime           @updatedAt

  @@index([usernameSecretId])
  @@index([passwordSecretId])
}

/// A functional area of an application (e.g. "Checkout"), entered manually or found by discovery.
model Feature {
  id             String        @id @default(cuid())
  applicationId  String
  application    Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  /// Representative entry point, if any.
  url            String?
  status         FeatureStatus @default(ACTIVE)
  source         ContentSource @default(MANUAL)
  /// The discovery run that found this feature.
  discoveryRunId String?
  discoveryRun   DiscoveryRun? @relation(fields: [discoveryRunId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  testSuites TestSuite[]
  testCases  TestCase[]
  pages      DiscoveredPage[]

  @@unique([applicationId, name])
  @@index([discoveryRunId])
}

// ─── Discovery ──────────────────────────────────────────────────────────────

model DiscoveryRun {
  id            String             @id @default(cuid())
  applicationId String
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status        DiscoveryRunStatus @default(QUEUED)
  startUrl      String
  maxDepth      Int                @default(2)
  maxPages      Int                @default(25)
  /// "Auto-test" runs queue test-case generation for every discovered feature when they complete.
  autoGenerate  Boolean            @default(false)
  pagesVisited  Int                @default(0)
  summary       String?
  errorMessage  String?
  /// Crawl statistics: element counts, blocked requests, skipped links, limits hit.
  stats         Json?
  /// Worker that claimed the run and its last heartbeat (to detect crashed workers).
  workerId      String?
  heartbeatAt   DateTime?
  triggeredById String?
  triggeredBy   User?              @relation("DiscoveryRunTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  features  Feature[]
  pages     DiscoveredPage[]
  artifacts Artifact[]

  @@index([applicationId, createdAt])
  @@index([status, createdAt])
  @@index([triggeredById])
}

/// A page reached by a discovery run. `elements` holds the links, forms, buttons, inputs and
/// navigation found on it (shape: src/modules/discovery/page-elements.ts). Input values are
/// never captured.
model DiscoveredPage {
  id         String       @id @default(cuid())
  runId      String
  run        DiscoveryRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  featureId  String?
  feature    Feature?     @relation(fields: [featureId], references: [id], onDelete: SetNull)
  url        String
  title      String?
  depth      Int
  statusCode Int?
  loadTimeMs Int?
  elements   Json
  error      String?
  createdAt  DateTime     @default(now())

  artifacts Artifact[]

  @@unique([runId, url])
  @@index([featureId])
}

// ─── Test design ────────────────────────────────────────────────────────────

/// Editable working copy of a group of test cases. Submitting it creates a PlanVersion snapshot.
model TestSuite {
  id            String          @id @default(cuid())
  applicationId String
  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  featureId     String?
  feature       Feature?        @relation(fields: [featureId], references: [id], onDelete: SetNull)
  name          String
  description   String?
  status        TestSuiteStatus @default(ACTIVE)
  source        ContentSource   @default(MANUAL)
  kind          SuiteKind       @default(STANDARD)
  createdById   String?
  createdBy     User?           @relation("TestSuiteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  testCases      TestCase[]
  planVersions   PlanVersion[]
  generationJobs GenerationJob[]

  @@index([applicationId, updatedAt])
  @@index([featureId])
  @@index([createdById])
}

model TestCase {
  id              String          @id @default(cuid())
  suiteId         String
  suite           TestSuite       @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  featureId       String?
  feature         Feature?        @relation(fields: [featureId], references: [id], onDelete: SetNull)
  /// Stable identity across plan versions, copies and regression suites (results are compared by it).
  caseKey         String          @default(uuid())
  title           String
  description     String?
  preconditions   String?
  /// Things that must be true before the case starts (accounts, data, state).
  prerequisites   String[]        @default([])
  /// Expected outcome; individual steps may also carry expectations.
  expectedResult  String?
  priority        Priority        @default(MEDIUM)
  type            TestCaseType    @default(FUNCTIONAL)
  status          TestCaseStatus  @default(ACTIVE)
  source          ContentSource   @default(MANUAL)
  reviewState     CaseReviewState @default(ACCEPTED)
  /// Requirement identifiers or short descriptions this case covers.
  requirementRefs String[]        @default([])
  generationJobId String?
  generationJob   GenerationJob?  @relation(fields: [generationJobId], references: [id], onDelete: SetNull)
  position        Int             @default(0)
  createdById     String?
  createdBy       User?           @relation("TestCaseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  steps   TestStep[]
  results TestResult[]
  defects Defect[]

  @@unique([suiteId, caseKey])
  @@index([suiteId, position])
  @@index([featureId])
  @@index([createdById])
  @@index([generationJobId])
}

model TestStep {
  id             String    @id @default(cuid())
  testCaseId     String
  testCase       TestCase  @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  position       Int
  /// Human-readable description of the step.
  action         String
  expectedResult String?
  /// Executable action; null for descriptive-only steps (such cases can't run automatically).
  kind           StepKind?
  /// Parameters for `kind`, validated by src/modules/execution/steps.ts.
  params         Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  stepResults StepResult[]

  @@unique([testCaseId, position])
}

// ─── Review ─────────────────────────────────────────────────────────────────

/// Immutable snapshot of a suite's cases and steps at submission time.
/// `snapshot` shape is defined and validated by `src/modules/test-suites/snapshot.ts`.
model PlanVersion {
  id             String            @id @default(cuid())
  suiteId        String
  suite          TestSuite         @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  version        Int
  status         PlanVersionStatus @default(PENDING_APPROVAL)
  snapshot       Json
  /// 1 = legacy (descriptive steps only), 2 = executable steps. See test-suites/snapshot.ts.
  snapshotFormat Int               @default(2)
  /// SHA-256 of the snapshot, computed by Postgres (generated column) so it always matches the
  /// stored content and can't be written by the application.
  contentHash    String            @default(dbgenerated())
  caseCount      Int
  changeSummary  String?
  createdById    String?
  createdBy      User?             @relation("PlanVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())
  approvedAt     DateTime?

  approvals    Approval[]
  testRuns     TestRun[]
  mutationRuns MutationRun[]

  @@unique([suiteId, version])
  @@index([status, createdAt])
  @@index([createdById])
}

model Approval {
  id                  String         @id @default(cuid())
  planVersionId       String
  planVersion         PlanVersion    @relation(fields: [planVersionId], references: [id], onDelete: Cascade)
  status              ApprovalStatus @default(PENDING)
  requestedById       String?
  requestedBy         User?          @relation("ApprovalRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  reviewerId          String?
  reviewer            User?          @relation("ApprovalReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  comment             String?
  /// Version hash when review was requested, and the hash the reviewer actually approved.
  requestedHash       String?
  decidedHash         String?
  /// Reviewer's roles at decision time, so execution can re-verify the reviewer was authorized.
  reviewerRole        UserRole?
  reviewerProjectRole ProjectRole?
  requestedAt         DateTime       @default(now())
  decidedAt           DateTime?

  @@index([planVersionId])
  @@index([status, requestedAt])
  @@index([reviewerId])
  @@index([requestedById])
}

// ─── Execution ──────────────────────────────────────────────────────────────

model TestRun {
  id              String          @id @default(cuid())
  planVersionId   String
  planVersion     PlanVersion     @relation(fields: [planVersionId], references: [id], onDelete: Cascade)
  status          TestRunStatus   @default(QUEUED)
  trigger         TestRunTrigger  @default(MANUAL)
  /// Target URL captured when the run was queued, so later application edits don't rewrite history.
  baseUrl         String
  /// Target environment and version hash captured at queue time; re-checked before execution.
  environment     AppEnvironment?
  contentHash     String?
  /// Infrastructure attempts used (test failures are never retried).
  attempts        Int             @default(0)
  maxAttempts     Int             @default(3)
  progressDone    Int             @default(0)
  progressTotal   Int             @default(0)
  workerId        String?
  heartbeatAt     DateTime?
  blockedReason   String?
  errorMessage    String?
  /// The earlier run these results were compared with.
  comparedToRunId String?
  comparedToRun   TestRun?        @relation("RunComparison", fields: [comparedToRunId], references: [id], onDelete: SetNull)
  comparedBy      TestRun[]       @relation("RunComparison")
  triggeredById   String?
  triggeredBy     User?           @relation("TestRunTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  results   TestResult[]
  artifacts Artifact[]
  report    Report?

  @@index([planVersionId, createdAt])
  @@index([status, createdAt])
  @@index([triggeredById])
}

model TestResult {
  id             String            @id @default(cuid())
  testRunId      String
  testRun        TestRun           @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  /// Live case, if it still exists. Title/priority are snapshotted from the plan version.
  testCaseId     String?
  testCase       TestCase?         @relation(fields: [testCaseId], references: [id], onDelete: SetNull)
  caseTitle      String
  casePriority   Priority
  /// Snapshot fields from the executed plan version.
  caseKey        String?
  featureName    String?
  category       TestCaseType?
  status         ResultStatus
  failureClass   FailureClass?
  /// Executions of this case in the run (1 + reproduction attempts) and their outcomes.
  attemptCount   Int               @default(1)
  attempts       Json?
  /// The case both passed and failed within this run.
  flaky          Boolean           @default(false)
  /// Share of verdict changes across this case's recent runs (0–1); null without enough history.
  flakeRate      Float?
  /// Same-origin pages and API calls the case actually reached: [{ type, method, path, status }].
  network        Json?
  comparison     ResultComparison?
  previousStatus ResultStatus?
  /// Heuristic hint only — always presented as unconfirmed.
  suspectedCause String?
  durationMs     Int?
  errorMessage   String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime          @default(now())

  stepResults StepResult[]
  defects     Defect[]
  artifacts   Artifact[]

  @@unique([testRunId, testCaseId])
  @@unique([testRunId, caseKey])
  @@index([testRunId, status])
  @@index([caseKey])
  @@index([testCaseId])
}

model StepResult {
  id             String        @id @default(cuid())
  testResultId   String
  testResult     TestResult    @relation(fields: [testResultId], references: [id], onDelete: Cascade)
  testStepId     String?
  testStep       TestStep?     @relation(fields: [testStepId], references: [id], onDelete: SetNull)
  position       Int
  /// Snapshot of the step as executed.
  action         String
  kind           StepKind?
  expectedResult String?
  actualResult   String?
  status         ResultStatus
  failureClass   FailureClass?
  durationMs     Int?
  errorMessage   String?
  createdAt      DateTime      @default(now())

  artifacts Artifact[]

  @@unique([testResultId, position])
  @@index([testStepId])
}

// ─── Outcomes ───────────────────────────────────────────────────────────────

model Defect {
  id               String             @id @default(cuid())
  applicationId    String
  application      Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  /// The failing result this defect was raised from, if any.
  testResultId     String?
  testResult       TestResult?        @relation(fields: [testResultId], references: [id], onDelete: SetNull)
  testCaseId       String?
  testCase         TestCase?          @relation(fields: [testCaseId], references: [id], onDelete: SetNull)
  title            String
  description      String?
  stepsToReproduce String?
  severity         DefectSeverity     @default(MAJOR)
  status           DefectStatus       @default(OPEN)
  verification     DefectVerification @default(REPRODUCED)
  /// Reproduction evidence: failure signature, attempt outcomes, run and artifact ids.
  evidence         Json?
  verifiedById     String?
  verifiedBy       User?              @relation("DefectVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt       DateTime?
  verificationNote String?
  /// Link to an external tracker (Jira, Linear, GitHub…).
  externalUrl      String?
  reportedById     String?
  reportedBy       User?              @relation("DefectReporter", fields: [reportedById], references: [id], onDelete: SetNull)
  assigneeId       String?
  assignee         User?              @relation("DefectAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  resolvedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  artifacts Artifact[]

  @@index([applicationId, status])
  @@index([status, severity])
  @@index([testResultId])
  @@index([testCaseId])
  @@index([assigneeId])
  @@index([reportedById])
}

/// A stored file (screenshot, trace, log…). Belongs to exactly one owner — enforced by a
/// CHECK constraint in the migration. Bytes live in object storage at `storageKey`.
model Artifact {
  id               String          @id @default(cuid())
  kind             ArtifactKind
  name             String
  storageKey       String          @unique
  mimeType         String
  sizeBytes        Int
  discoveryRunId   String?
  discoveryRun     DiscoveryRun?   @relation(fields: [discoveryRunId], references: [id], onDelete: Cascade)
  discoveredPageId String?
  discoveredPage   DiscoveredPage? @relation(fields: [discoveredPageId], references: [id], onDelete: Cascade)
  testRunId        String?
  testRun          TestRun?        @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  testResultId     String?
  testResult       TestResult?     @relation(fields: [testResultId], references: [id], onDelete: Cascade)
  stepResultId     String?
  stepResult       StepResult?     @relation(fields: [stepResultId], references: [id], onDelete: Cascade)
  defectId         String?
  defect           Defect?         @relation(fields: [defectId], references: [id], onDelete: Cascade)
  createdAt        DateTime        @default(now())

  @@index([discoveryRunId])
  @@index([discoveredPageId])
  @@index([testRunId])
  @@index([testResultId])
  @@index([stepResultId])
  @@index([defectId])
}

model Report {
  id             String   @id @default(cuid())
  testRunId      String   @unique
  testRun        TestRun  @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  title          String
  summary        String?
  passed         Int      @default(0)
  failed         Int      @default(0)
  skipped        Int      @default(0)
  blocked        Int      @default(0)
  inconclusive   Int      @default(0)
  /// Cases that both passed and failed within the run.
  flaky          Int      @default(0)
  errored        Int      @default(0)
  /// Non-passing cases by failure class (APPLICATION, TEST_DEFINITION, INFRASTRUCTURE…).
  failureClasses Json?
  regressions    Int      @default(0)
  fixed          Int      @default(0)
  /// Per-feature coverage and pass rates (see src/modules/reports/build.ts).
  coverage       Json?
  createdAt      DateTime @default(now())
}

/// An AI (or heuristic) test-case generation request. Output is saved as PROPOSED cases in a
/// draft suite and must be reviewed and approved before anything can run.
model GenerationJob {
  id            String           @id @default(cuid())
  applicationId String
  application   Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  suiteId       String?
  suite         TestSuite?       @relation(fields: [suiteId], references: [id], onDelete: SetNull)
  status        GenerationStatus @default(QUEUED)
  featureIds    String[]
  requirements  String?
  provider      String?
  model         String?
  /// SHA-256 of the prompt sent (the prompt itself isn't stored).
  promptHash    String?
  caseCount     Int              @default(0)
  rejectedCount Int              @default(0)
  errorMessage  String?
  usage         Json?
  requestedById String?
  requestedBy   User?            @relation("GenerationJobRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now())
  finishedAt    DateTime?

  testCases TestCase[]

  @@index([applicationId, createdAt])
  @@index([status])
  @@index([requestedById])
}

/// Append-only, hash-chained audit trail. A trigger rejects UPDATE and DELETE. No foreign keys,
/// so history survives deletion of the records it describes.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  createdAt  DateTime @default(now())
  actorId    String?
  actorEmail String?
  action     String
  entityType String
  entityId   String
  projectId  String?
  data       Json?
  prevHash   String?
  hash       String   @unique

  @@index([projectId, createdAt])
  @@index([entityType, entityId])
}

/// Expected appearance of one ASSERT_VISUAL step (application + case + name). A run never
/// approves its own capture: candidates stay PENDING until a reviewer approves the exact
/// image (by hash). At most one APPROVED baseline per key (partial unique index).
model VisualBaseline {
  id            String         @id @default(cuid())
  applicationId String
  application   Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  caseKey       String
  name          String
  status        BaselineStatus @default(PENDING)
  storageKey    String         @unique
  sha256        String
  width         Int
  height        Int
  /// Run that captured it.
  testRunId     String?
  reviewerId    String?
  reviewer      User?          @relation("BaselineReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  reviewNote    String?
  createdAt     DateTime       @default(now())

  @@index([applicationId, caseKey, name, status])
  @@index([status, createdAt])
  @@index([reviewerId])
}

// ─── Inventory (what the application is known to contain) ──────────────────

enum InventoryKind {
  ROUTE
  API_ENDPOINT
  ROLE
  REQUIREMENT
  WORKFLOW
}

/// Where an inventory item was learned from. Each source's contribution is replaced as a
/// whole when that source is analysed again.
enum InventorySource {
  OPENAPI
  REQUIREMENTS
  SOURCE_CODE
  DISCOVERY
}

enum Confidence {
  HIGH
  MEDIUM
  LOW
}

enum AnalysisStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

/// An uploaded OpenAPI spec or requirements document (kept verbatim for traceability).
model InventoryDocument {
  id            String          @id @default(cuid())
  applicationId String
  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  source        InventorySource
  name          String
  content       String
  sha256        String
  itemCount     Int             @default(0)
  createdById   String?
  createdBy     User?           @relation("InventoryDocumentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())

  @@index([applicationId, source, createdAt])
  @@index([createdById])
}

/// Static analysis of the application's authorized repository. Code is read, never run.
model SourceAnalysis {
  id            String         @id @default(cuid())
  applicationId String
  application   Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status        AnalysisStatus @default(QUEUED)
  repoUrl       String
  repoBranch    String?
  /// Optional application secret (by name) holding a read-only access token.
  tokenSecret   String?
  commitSha     String?
  stats         Json?
  errorMessage  String?
  workerId      String?
  triggeredById String?
  triggeredBy   User?          @relation("SourceAnalysisTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime       @default(now())

  @@index([status, createdAt])
  @@index([applicationId, createdAt])
  @@index([triggeredById])
}

/// One known route, API endpoint, role, requirement or workflow of an application.
model InventoryItem {
  id            String        @id @default(cuid())
  applicationId String
  application   Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  kind          InventoryKind
  /// Normalized identity: "/cart", "GET /api/cart", "admin", "REQ-12", "checkout-with-coupon".
  key           String
  title         String
  /// Kind-specific facts (parameters, contracts, acceptance criteria, scenario steps…).
  details       Json?
  /// [{ source, ref, documentId?, analysisId? }]: every place this item was found.
  sources       Json
  confidence    Confidence    @default(MEDIUM)
  /// Requires authentication, as far as the sources tell.
  protected     Boolean?
  /// Roles mentioned as allowed for this item.
  roles         String[]      @default([])
  /// False once no source mentions it any more (kept for coverage history).
  active        Boolean       @default(true)
  firstSeenAt   DateTime      @default(now())
  lastSeenAt    DateTime      @default(now())

  @@unique([applicationId, kind, key])
  @@index([applicationId, active, kind])
}

// ─── Mutation testing ───────────────────────────────────────────────────────

enum MutationRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  /// The baseline didn't pass, or the plan can't be executed: no score is computed.
  BLOCKED
  FAILED
}

/// Measures how many deliberately mutated responses an approved plan detects.
model MutationRun {
  id            String            @id @default(cuid())
  planVersionId String
  planVersion   PlanVersion       @relation(fields: [planVersionId], references: [id], onDelete: Cascade)
  status        MutationRunStatus @default(QUEUED)
  mutantLimit   Int               @default(20)
  /// The ordinary (persisted, verified) run used as the unmutated baseline.
  baselineRunId String?
  killed        Int               @default(0)
  survived      Int               @default(0)
  /// Neither killed nor survived: only inconclusive outcomes, or the change never applied.
  unclear       Int               @default(0)
  /// killed / (killed + survived + unclear); null when no mutant could be evaluated.
  score         Float?
  /// [{ id, operator, target, location, description, outcome, killedBy, note }]
  mutants       Json?
  blockedReason String?
  errorMessage  String?
  workerId      String?
  triggeredById String?
  triggeredBy   User?             @relation("MutationRunTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime          @default(now())

  @@index([status, createdAt])
  @@index([planVersionId, createdAt])
  @@index([triggeredById])
}

// ─── Benchmark ──────────────────────────────────────────────────────────────

/// One execution of the accuracy benchmark (bundled corpus with seeded faults).
model BenchmarkRun {
  id            String         @id @default(cuid())
  status        AnalysisStatus @default(RUNNING)
  corpusVersion String
  /// Commit of the agent being measured, when known.
  gitCommit     String?
  /// Options: faults included, repeats, mutation analysis on/off.
  config        Json
  /// Headline numbers: recall, precision, reliability, coverage, mutation score.
  metrics       Json?
  /// Per-fault and per-run evidence behind the metrics.
  details       Json?
  errorMessage  String?
  durationMs    Int?
  startedAt     DateTime       @default(now())
  finishedAt    DateTime?

  @@index([startedAt])
}
