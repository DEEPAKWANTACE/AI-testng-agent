# Copy to .env and adjust: cp .env.example .env
# .env is git-ignored; never commit real credentials.

# ── Database (required) ────────────────────────────────────────────────
# PostgreSQL connection string used by the app and the Prisma CLI.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_qa_agent?schema=public"

# ── Demo data (optional) ───────────────────────────────────────────────
# Password given to the demo users created by `npm run db:seed` (min. 12 characters).
# If unset, the seed generates a random one and prints it once.
# SEED_USER_PASSWORD=

# ── Tests ──────────────────────────────────────────────────────────────
# Throwaway database for `npm test`. Its name must end in _test: the
# integration tests wipe it before every test.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_qa_agent_test?schema=public"

# ── Secrets referenced by applications ─────────────────────────────────
# Applications store *references* to secrets, never values. env:// references
# resolve from this server's environment and must start with QA_, e.g.
# env://QA_STOREFRONT_PASSWORD reads:
# QA_STOREFRONT_PASSWORD=

# ── Discovery worker (npm run worker:discovery) ────────────────────────
# DISCOVERY_PAGE_TIMEOUT_MS=15000      # per page
# DISCOVERY_RUN_TIMEOUT_MS=300000      # whole run (hard stop)
# DISCOVERY_POLL_INTERVAL_MS=3000
# DISCOVERY_STALE_AFTER_MS=120000      # fail RUNNING runs whose worker stopped heartbeating
# DISCOVERY_ALLOW_EXTERNAL_ASSETS=false  # true: also load public third-party assets (ports 80/443)
# Where screenshots and crawl logs are stored (default ./storage/artifacts).
# ARTIFACT_STORAGE_DIR=
#
# Development only — ignored when NODE_ENV=production. Exact host:port pairs the worker may
# crawl even though they are private, e.g. the local Demo Shop (npm run demo:target):
# DISCOVERY_PRIVATE_ALLOWLIST="127.0.0.1:4100"
# QA_DEMO_EMAIL="shopper@demo-shop.test"
# QA_DEMO_PASSWORD="demo-shopper-pass-1"

# ── Job queue (Redis + BullMQ) ─────────────────────────────────────────
# docker compose up -d redis   — then run the worker: npm run worker:jobs
REDIS_URL="redis://127.0.0.1:6379"
# QUEUE_PREFIX=qa
# Integration tests use Redis database 15 (it is flushed before each test run):
# TEST_REDIS_URL="redis://127.0.0.1:6379/15"

# ── Test-case generation ───────────────────────────────────────────────
# heuristic (default): built-in rule-based generator, no external calls.
# openai-compatible: any OpenAI-style chat API (OpenAI, Azure OpenAI, OpenRouter,
# Ollama, vLLM, LM Studio…). The key is read only from the environment.
# LLM_PROVIDER=heuristic
# LLM_BASE_URL="https://api.openai.com/v1"
# LLM_MODEL=
# LLM_API_KEY=
# LLM_TIMEOUT_MS=120000
# LLM_MAX_OUTPUT_TOKENS=8000

# ── Test execution worker (npm run worker:jobs) ────────────────────────
# Environments the worker may test. PRODUCTION is blocked unless listed here.
# EXECUTION_ALLOWED_ENVIRONMENTS="DEVELOPMENT,STAGING"
# EXECUTION_CONCURRENCY=2
# EXECUTION_STEP_TIMEOUT_MS=10000
# EXECUTION_RUN_TIMEOUT_MS=900000
# EXECUTION_STALE_AFTER_MS=60000     # re-queue runs whose worker stopped heartbeating
# EXECUTION_ALLOW_EXTERNAL_ASSETS=false
# EXECUTION_REPRODUCE_ATTEMPTS=2      # re-executions of a non-passing case before any defect is reported (1-5)

# Encrypts test-account credentials typed into the Auto-test form (AES-256-GCM, 32 bytes base64).
# Generate with: openssl rand -base64 32   — keep it out of the database and out of git.
SECRETS_ENCRYPTION_KEY=
